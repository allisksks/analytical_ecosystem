# ---------- required ----------
# openssl rand -hex 32
SECRET_KEY=
# python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=
# first administrator (created on first start if no users exist)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# ---------- optional ----------
PUBLIC_URL=http://localhost:8080
# set to false only when the platform is served over plain HTTP (no TLS)
COOKIE_SECURE=true
HTTP_PORT=8080
POSTGRES_PASSWORD=platform
CLICKHOUSE_PASSWORD=platform
# create demo organisation, game projects and a demo data source
BOOTSTRAP_DEMO=true
DEMO_SCALE=1.0

# ---------- AI assistant (OpenAI-compatible API) ----------
# Off by default: the platform fully works without AI. Step-by-step setup: docs/ai-setup.md
AI_ENABLED=false
AI_BASE_URL=http://ollama:11434/v1
AI_API_KEY=
AI_CHAT_MODEL=qwen3:8b
# optional: a separate (stronger) model for SQL generation; empty = AI_CHAT_MODEL
AI_SQL_MODEL=
# optional: embeddings for semantic search in the knowledge base; empty = full-text search only
AI_EMBEDDING_MODEL=
# "Bearer" (Ollama, vLLM, Yandex API key via OpenAI SDK style) or "Api-Key"
AI_AUTH_SCHEME=Bearer
AI_PROJECT_HEADER=
AI_PROJECT_ID=
# Qwen3: answer without the long reasoning phase (faster interactive answers)
AI_NO_THINK=true
# reasoning models (Qwen3.6) spend tokens on hidden reasoning first: keep the budget generous
AI_MAX_TOKENS=8000
AI_TIMEOUT_S=300
# provider-specific request fields (JSON), e.g. to switch reasoning off or down:
# AI_EXTRA_BODY={"reasoning_effort": "low"}
AI_EXTRA_BODY=
# false on client installations with real data: cloud model endpoints are refused
AI_ALLOW_CLOUD=true

# --- Option A: Yandex AI Studio, Qwen3.6 35B (demo data only) ---
# AI_ENABLED=true
# AI_BASE_URL=https://llm.api.cloud.yandex.net/v1
# AI_API_KEY=<API key of the service account>
# AI_PROJECT_HEADER=OpenAI-Project
# AI_PROJECT_ID=<folder_id>
# AI_CHAT_MODEL=gpt://<folder_id>/qwen3.6-35b-a3b/latest
# AI_EMBEDDING_MODEL=emb://<folder_id>/text-search-doc/latest
#
# --- Option B: local Ollama (data never leaves the server) ---
# AI_ENABLED=true
# AI_BASE_URL=http://ollama:11434/v1
# AI_CHAT_MODEL=qwen3:8b
# AI_EMBEDDING_MODEL=nomic-embed-text
