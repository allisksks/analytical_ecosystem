# ---------- required ----------
# openssl rand -hex 32
SECRET_KEY=
# python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=
# first administrator (created on first start if no users exist)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# ---------- optional ----------
PUBLIC_URL=http://localhost:8080
HTTP_PORT=8080
POSTGRES_PASSWORD=platform
CLICKHOUSE_PASSWORD=platform
# create demo organisation, game projects and a demo data source
BOOTSTRAP_DEMO=true
DEMO_SCALE=1.0

# ---------- AI assistant (OpenAI-compatible API) ----------
# Off by default: the platform fully works without AI.
AI_ENABLED=false
# Local Ollama (docker compose --profile ai up -d; then: docker compose exec ollama ollama pull qwen3:8b)
AI_BASE_URL=http://ollama:11434/v1
AI_CHAT_MODEL=qwen3:8b
AI_SQL_MODEL=
AI_EMBEDDING_MODEL=
AI_API_KEY=
# Yandex AI Studio (Qwen3 235B) example — demo data only, see docs/ai-setup.md:
# AI_BASE_URL=https://llm.api.cloud.yandex.net/v1
# AI_API_KEY=<api key>
# AI_CHAT_MODEL=gpt://<folder_id>/qwen3-235b-a22b-fp8/latest
# AI_PROJECT_HEADER=OpenAI-Project
# AI_PROJECT_ID=<folder_id>
AI_PROJECT_HEADER=
AI_PROJECT_ID=
# set to false on client installations: cloud model endpoints are refused
AI_ALLOW_CLOUD=true
